# ===== 大模型配置（OpenAI 兼容接口）=====
# 支持 DeepSeek / 通义千问 / 智谱 GLM 等任意 OpenAI 兼容服务
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# DeepSeek V4 等推理模型思考模式开关：true=关闭思考直接出答案（更快）；false=开启思考（输出思维链，延迟/成本更高）
LLM_DISABLE_THINKING=true
# 超时与重试（秒 / 次）
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ===== 向量化（Embedding）配置 =====
# 可选值：api（调用兼容接口，默认）| local（本地 bge 模型，需装 sentence-transformers）
EMBEDDING_PROVIDER=api
# 使用 api 时，可复用 LLM 的 key/base_url，或单独配置
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
# api 可用：text-embedding-3-small / Qwen/Qwen3-Embedding-0.6B 等；
# local 可用：BAAI/bge-small-zh-v1.5 / BAAI/bge-m3。
# 第三方 OpenAI-compatible 服务（如 SiliconFlow/Qwen）由服务端负责 tokenizer，
# 不要让客户端用 OpenAI tiktoken 将文本转换为 token ID 数组。
EMBEDDING_MODEL=text-embedding-3-small
# API 默认直接发送原始字符串；原生 OpenAI tokenizer 场景可显式设为 true
EMBEDDING_CHECK_CTX_LENGTH=false
# 可选：本地模型目录。填写后不访问 HuggingFace，适合离线部署；相对路径基于 backend/。
EMBEDDING_LOCAL_PATH=
# embedding API 超时与重试（local 本地模型不涉及网络）
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=2
# 本地模型设备：auto（优先 CUDA）、cuda、cuda:0 或 cpu；显式 cuda 不可用时会快速失败
EMBEDDING_DEVICE=auto
# HuggingFace/Sentence-Transformers 缓存目录，建议放在项目可写目录以避免用户目录权限问题
HF_HOME=./data/hf_cache
SENTENCE_TRANSFORMERS_HOME=./data/hf_cache/hub

# ===== 存储路径 =====
RAW_DIR=./data/raw

# ===== 检索参数 =====
TOP_K=5
# 相似度阈值（0~1）：低于此分数的结果被过滤，避免不相关内容干扰回答
SIMILARITY_THRESHOLD=0.3
# 混合检索：向量 + 全文（PostgreSQL FTS），RRF 融合
ENABLE_HYBRID_SEARCH=true
# RRF 融合参数：k 越大排名差异越平滑
RRF_K=60
# 混合检索时各路候选数量（取 Top-N 做融合，再截断到 TOP_K）
HYBRID_CANDIDATE_K=60

# ===== 面向 RAG 的 Query 改写 =====
# 首轮和多轮问题都生成 standalone_query + 一条 retrieval_query；失败自动使用原问题
ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_HISTORY_MESSAGES=6
QUERY_REWRITE_MAX_TOKENS=400
QUERY_REWRITE_TIMEOUT=30
QUERY_REWRITE_RETRIES=1
QUERY_REWRITE_PROMPT_VERSION=rag-query-v2
QUERY_REWRITE_MAX_CHARS=400
# Query Preparation 同时由 LLM 判断是否需要进入 RAG；路由节点负责安全兜底
ENABLE_LLM_QUERY_ROUTING=true
QUERY_ROUTING_PROMPT_VERSION=rag-routing-v1
QUERY_ROUTING_CONFIDENCE_THRESHOLD=0.75

# ===== 自动会话记忆 =====
MEMORY_ENABLED=true
MEMORY_MAX_CONTEXT_ITEMS=8
MEMORY_CANDIDATE_LIMIT=50
MEMORY_SUMMARY_TRIGGER_MESSAGES=8
MEMORY_SUMMARY_TRIGGER_CHARS=5000
MEMORY_EXTRACT_MAX_ITEMS=5
MEMORY_EXTRACT_MAX_TOKENS=600
MEMORY_TASK_TIMEOUT=30
MEMORY_MIN_IMPORTANCE=0.55

# ===== 请求可靠性边界 =====
# 多专家（含人物关系纠偏重跑）场景建议 180；单轮直答场景可保持 120
AGENT_REQUEST_TIMEOUT=180

# ===== Agent 执行策略与预算 =====
# auto 会根据问题复杂度选择 direct 或 plan_execute
AGENT_MAX_STEPS=6
AGENT_TOOL_TIMEOUT=20
AGENT_MAX_EXPERTS=4
AGENT_MULTI_EXPERT_TIMEOUT=45
AGENT_EXPERT_MAX_TOKENS=800
AGENT_SYNTHESIS_MAX_TOKENS=1200
# 专家任务分派：hybrid=固定契约+LLM补充；template=完全使用固定模板
AGENT_EXPERT_DISPATCH_MODE=hybrid
AGENT_DISPATCH_MAX_TOKENS=500
AGENT_REPORT_SIMILARITY_THRESHOLD=0.72
AGENT_EXPERT_CORRECTION_RETRIES=1

# 中文查询词法召回（jieba + pg_trgm；失败自动回退 simple FTS）
ENABLE_CHINESE_LEXICAL_SEARCH=true
CHINESE_LEXICAL_MAX_TERMS=8

# 小说主检索数量，以及命中章节前后补充的相邻片段窗口
NOVEL_CONTEXT_K=8
NOVEL_NEIGHBOR_WINDOW=1
NOVEL_CHUNK_SIZE=650
NOVEL_CHUNK_OVERLAP=120

# ===== 用户认证与多租户隔离 =====
# 默认开启：users 表 + JWT 登录，前端会跳转登录页。JWT_SECRET 为必填，
# 未配置将启动失败；纯本地裸跑开发可显式指定 JWT_SECRET=dev-xxx python app/main.py。
USER_AUTH_ENABLED=true
# JWT 签名密钥（开启鉴权时必填）。生产必须改成固定的高强度随机串；不要使用默认/空值。
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=1440
# 兼容旧脚本调用：静态 Bearer token 白名单。示例：API_TOKENS=alice:alice-token,bob:bob-token
API_TOKENS=
DEFAULT_USER=default

# ===== 手动重新索引：LLM 辅助章节规则发现 =====
ENABLE_LLM_CHAPTER_DETECTION=true
# 留空时复用 LLM_MODEL
CHAPTER_DETECTION_MODEL=
CHAPTER_DETECTION_MAX_TOKENS=800
CHAPTER_DETECTION_TIMEOUT=45
CHAPTER_DETECTION_RETRIES=1
CHAPTER_DETECTION_CANDIDATE_LIMIT=240
CHAPTER_DETECTION_CONFIDENCE_THRESHOLD=0.75
CHAPTER_DETECTION_PROMPT_VERSION=chapter-discovery-v1
# ===== 重排（默认开启，纯重排模式；默认走 SiliconFlow 远程 API）=====
# 远程：省去 ~2.3GB 本地模型下载，需配 RERANKER_API_KEY（未配会在首次重排调用时 fail-fast）；
# local 仅供离线/无 key 环境显式选用（如 BAAI/bge-reranker-v2-m3）。
ENABLE_RERANKER=true
RERANKER_PROVIDER=siliconflow
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
# siliconflow 配置：POST {RERANKER_BASE_URL}{RERANKER_ENDPOINT}
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_ENDPOINT=/rerank
RERANKER_API_KEY=your_siliconflow_api_key_here
RERANKER_TIMEOUT=30
RERANKER_MAX_RETRIES=2
# 远程调用失败时跳过重排，继续使用原候选回答，不自动加载本地模型。
# 交给重排器的候选数量（需 >= TOP_K；远程候选越多，TPM/延迟越高）
RERANKER_CANDIDATE_N=60
RERANKER_CANDIDATE_THRESHOLD=0.15
# 重排保护（blend）：融合重排分、RRF 分和原始通道分；A/B 中纯重排优于保护模式，默认关闭
ENABLE_RERANKER_BLEND=false
RERANKER_WEIGHT=0.70
RRF_WEIGHT=0.20
RAW_SCORE_WEIGHT=0.10
RERANKER_PROTECT_TOP_N=3
RERANKER_PROTECT_SLOTS=2
# 旧版确定性 Query Expansion 已由面向 RAG 的 LLM Query Rewrite 取代，保留配置仅用于兼容旧环境
# 章节内二级检索：先召回章节，再在命中章节内精排片段；默认关闭
ENABLE_CHAPTER_LOCAL_RETRIEVAL=false
CHAPTER_LOCAL_CANDIDATE_K=40

# ===== 向量维度（必须与 EMBEDDING_MODEL 匹配！）=====
# text-embedding-3-small=1536 / text-embedding-3-large=3072
# BAAI/bge-m3=1024 / BAAI/bge-base-zh-v1.5=768
EMBED_DIM=1536
# 本地大模型生成向量的批大小；显存/内存不足时可调小
EMBEDDING_BATCH_SIZE=32

# ===== PostgreSQL + pgvector（向量与业务数据共用同一库）=====
# 本地直连开发时填 localhost；docker-compose 中后端通过服务名 postgres 访问
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_agent
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=change_me_to_a_strong_password
# 也可直接给完整连接串（优先级最高）：
# DATABASE_URL=postgresql+psycopg2://job_agent:change_me_to_a_strong_password@postgres:5432/job_agent

# ===== CORS 允许的前端来源 =====
# 逗号分隔；生产环境请改为实际前端域名，如 https://your-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
